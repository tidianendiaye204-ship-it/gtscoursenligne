,null,{\"className\":\"font-semibold\",\"children\":\"Puis-je avoir accès à toutes les corrections complètes sur le site ?\"}],[\"$\",\"span\",null,{\"className\":\"transition-transform duration-300 group-open:-rotate-180\",\"children\":[\"$\",\"svg\",null,{\"className\":\"w-5 h-5 text-solaire\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"viewBox\":\"0 0 24 24\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":\"2\",\"d\":\"M19 9l-7 7-7-7\"}]}]}]]}],[\"$\",\"div\",null,{\"className\":\"p-6 pt-0 font-body text-white/70 leading-relaxed bg-solaire/5\",\"children\":\"Sur le site public, nous offrons la correction d'un seul exercice par série pour vous montrer la qualité de notre pédagogie. Les corrections complètes détaillées, ainsi que l'assistance 7j/7 pour vos questions bloquantes, sont des privilèges exclusivement réservés aux élèves inscrits dans nos groupes WhatsApp de cours en direct.\"}]]}]\n17:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n31:null\n34:I[622,[],\"IconMark\"]\n33:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Groupe Trio Scientifique (GTS) - Cours d'Excellence au Sénégal (Maths, PC, SVT) & Concours\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Le Groupe Trio Scientifique (GTS) offre les meilleurs cours en ligne au Sénégal en Mathématiques, Physique-Chimie et SVT. Préparation intensive au Bac et aux grandes écoles (ESP, EPT, ENSA, EMS).\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"groupe trio scientifique,maths senegal,pc senegal,physique chimie senegal,svt senegal,cours en ligne senegal,préparation bac senegal,concours esp senegal,concours ept senegal,concours ensa senegal,ensa école nationale supérieure d'agriculture,gts cours en ligne\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://gtscoursenligne.com\"}],[\"$\",\"meta