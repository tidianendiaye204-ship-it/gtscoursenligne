{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "trio-scientifique",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trio-scientifique-db",
			"database_id": "8f25347a-e212-4f2f-beb2-1ffd792f2ee9"
		}
	],
	"r2_buckets": [
		{
			"binding": "FICHIERS",
			"bucket_name": "trio-scientifique-fichiers"
		}
	]
}